<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="mundo_avion">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Escena -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Plano de tierra -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Modelo del avión que sigue ángulos del MPU6050 -->
    <model name="avion">
      <static>true</static>  <!-- Static para control total de la pose -->
      <pose>0 0 1 0 0 0</pose>  <!-- Pose inicial nivelada -->

      <link name="base_link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <iyy>0.1</iyy>
            <izz>0.1</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
        
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/yoel/avion_ws/src/avion/models/avion.dae</uri>
              <scale>1000 1000 1000</scale>
            </mesh>
          </geometry>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>30 30 3</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Plugin para publicar la pose actual -->
      <plugin name="SetPoseTopicPlugin" filename="libSetPoseTopicPlugin.so"/>
    </model>

    <!-- Luz del sol -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
  </world>
</sdf>